{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/4citeB4U/Machine-Consciousness/schemas/contributor-packet.schema.json",
  "title": "LeeWay Contributor Capability Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contributorId", "identity", "capabilities", "limits", "provenance", "admission"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contributorId": { "enum": ["local-codex", "local-antigravity", "online-chatgpt", "online-gemini", "human-creator"] },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "channel", "registeredAt"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["local", "online", "human"] },
        "modelId": { "type": "string" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "observedAt": { "type": "string", "format": "date-time" }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidenceRefs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "liveActionReceipt": { "type": "string" }
        }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contributionId", "kind", "statement", "nativeArtifactRefs"],
        "properties": {
          "contributionId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["method", "constraint", "implementation", "evaluation", "domain-knowledge"] },
          "statement": { "type": "string", "minLength": 1 },
          "nativeArtifactRefs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "acceptanceTestRefs": { "type": "array", "items": { "type": "string" } },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "limits": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "rightsReviewed"],
      "properties": {
        "sourceType": { "enum": ["observed-response", "local-artifact", "human-authored", "provider-documentation", "registry-only"] },
        "rightsReviewed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "deterministicNativeArtifactCreated"],
      "properties": {
        "status": { "enum": ["PENDING_CAPTURE", "OBSERVED", "EVALUATED", "VERIFIED", "REJECTED", "ADMITTED"] },
        "deterministicNativeArtifactCreated": { "type": "boolean" },
        "veritasReceipt": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
