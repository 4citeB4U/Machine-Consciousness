    "normalGitPayload": "FORBIDDEN_FOR_WEIGHTS",
    "licenseReview": "REQUIRED",
    "ownerApproval": "REQUIRED",
    "quotaAndSizeReview": "REQUIRED",
    "integrityManifest": "REQUIRED",
    "inferenceBeforeMaterializationAndVerification": "FORBIDDEN"
  },
  "control": {
    "consciousnessAuthority": "LEEWAY_MACHINE_CONSCIOUSNESS",
    "deviceBridgeRoute": "LEEWAY_DEVICE_BRIDGE::AGENT_TABLET::MODEL_HUB",
    "providerAfterAdmission": "NOT_REQUIRED",
    "directProviderRoute": "FORBIDDEN",
    "modelOutput": "CAPABILITY_PROVIDER_EVIDENCE_ONLY"
  }
}
