{
  "schemaVersion": "leeway.model-hub.github-source.v1",
  "contractId": "LEEWAY_MODEL_HUB_GITHUB_SOURCE_V1",
  "authority": "LEEWAY_MODEL_HUB",
  "canonicalRepository": "4citeB4U/LeeWay-Model-Hub",
  "canonicalRepositoryUrl": "https://github.com/4citeB4U/LeeWay-Model-Hub",
  "runtimeManifestPath": "registry/leeway-model-hub-runtime-manifest.v1.json",
  "runtimeManifestUrl": "https://raw.githubusercontent.com/4citeB4U/LeeWay-Model-Hub/main/registry/leeway-model-hub-runtime-manifest.v1.json",
  "sourceAuthority": "GITHUB_REPOSITORY",
  "sourceRefPolicy": {
