    "desiredResidentRuntimeCount": 2,
    "defaultLifecycle": "PAUSED_RESIDENT",
    "wake": "FORMULA_AND_DEVICE_BRIDGE_ADMITTED_TASK_ONLY",
    "active": "BOUNDED_TASK_EXECUTION",
    "return": "PAUSED_RESIDENT",
