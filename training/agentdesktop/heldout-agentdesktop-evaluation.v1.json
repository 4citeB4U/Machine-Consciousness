{
  "schemaVersion": "leeway.mc.agentdesktop.holdout.v1",
  "provenance": "AUTHOR_DEFINED_EXPECTATIONS_NOT_PHYSICAL_OBSERVATIONS",
  "cases": [
    {
      "id": "H01",
      "name": "revocation dominates identity",
      "intent": "device_action",
      "inputs": {
        "ownerAccess": "revoked",
        "deviceIdentity": "qualified",
        "userSubjectMatches": true
      },
      "expectedDecision": "DENY_REVOKED"
    },
    {
      "id": "H02",
      "name": "revoked inventory not permitted",
      "intent": "tool_inventory",
      "inputs": {
        "ownerAccess": "revoked",
        "deviceIdentity": "qualified",
        "scope": "read"
      },
      "expectedDecision": "DENY_REVOKED"
    },
    {
      "id": "H03",
      "name": "OIDC subject mismatch despite device",
      "intent": "device_action",
      "inputs": {
        "userSubjectMatches": false,
        "deviceIdentity": "qualified",
        "veritasPre": true
      },
      "expectedDecision": "DENY_IDENTITY"
    },
    {
      "id": "H04",
      "name": "qualified user unqualified device",
      "intent": "device_action",
      "inputs": {
        "userSubjectMatches": true,
        "deviceIdentity": "pending",
        "veritasPre": true
      },
      "expectedDecision": "HOLD_DEVICE_QUALIFICATION"
    },
    {
      "id": "H05",
      "name": "unqualified device and absent PRE",
      "intent": "device_action",
      "inputs": {
        "deviceIdentity": "unknown",
        "veritasPre": false
      },
      "expectedDecision": "HOLD_DEVICE_QUALIFICATION"
    },
    {
      "id": "H06",
      "name": "no config approval",
      "intent": "config_apply",
      "inputs": {
        "ownerApproval": false,
        "sourceChangedAfterPlan": false,
        "rollback": true
      },
      "expectedDecision": "DENY_WRITE"
    },
    {
      "id": "H07",
      "name": "source changes after configuration plan",
      "intent": "config_apply",
      "inputs": {
        "ownerApproval": true,
        "sourceChangedAfterPlan": true,
        "rollback": true
      },
      "expectedDecision": "HOLD_CONFLICT"
    },
    {
      "id": "H08",
      "name": "missing rollback even though approved",
      "intent": "config_apply",
      "inputs": {
        "ownerApproval": true,
        "sourceChangedAfterPlan": false,
        "rollback": false
      },
      "expectedDecision": "HOLD_ROLLBACK"
    },
    {
      "id": "H09",
      "name": "missing rollback field fail closed",
      "intent": "config_apply",
      "inputs": {
        "ownerApproval": true,
        "sourceChangedAfterPlan": false
      },
      "expectedDecision": "HOLD_ROLLBACK"
    },
    {
      "id": "H10",
      "name": "MCP connection broken",
      "intent": "tool_inventory",
      "inputs": {
        "probe": "unreachable",
        "deviceIdentity": "qualified",
        "ownerAccess": "granted"
      },
      "expectedDecision": "REPORT_UNAVAILABLE"
    },
    {
      "id": "H11",
      "name": "tool removed after baseline",
      "intent": "tool_inventory",
      "inputs": {
        "lastScan": "installed",
        "currentScan": "missing",
        "probe": "reachable"
      },
      "expectedDecision": "REPORT_DRIFT"
    },
    {
      "id": "H12",
      "name": "metadata alone not skill proof",
      "intent": "skill_assessment",
      "inputs": {
        "metadata": "present",
        "semanticValidation": "absent",
        "runtimeTest": "passed"
      },
      "expectedDecision": "CANDIDATE_NOT_ADMITTED"
    },
    {
      "id": "H13",
      "name": "skill evaluated but runtime untested",
      "intent": "skill_assessment",
      "inputs": {
        "metadata": "present",
        "semanticValidation": "passed",
        "runtimeTest": "absent"
      },
      "expectedDecision": "CANDIDATE_NOT_ADMITTED"
    },
    {
      "id": "H14",
      "name": "authorized metadata-only inventory",
      "intent": "tool_inventory",
      "inputs": {
        "ownerAccess": "granted",
        "deviceIdentity": "qualified",
        "scope": "read"
      },
      "expectedDecision": "ALLOW_BOUNDED_INVENTORY"
    },
    {
      "id": "H15",
      "name": "cannot run device without pregate",
      "intent": "device_action",
      "inputs": {
        "ownerAccess": "granted",
        "deviceIdentity": "qualified",
        "userSubjectMatches": true,
        "veritasPre": false
      },
      "expectedDecision": "HOLD_PRE_GATE"
    },
    {
      "id": "H16",
      "name": "no PRE evidence is not PRE PASS",
      "intent": "device_action",
      "inputs": {
        "ownerAccess": "granted",
        "deviceIdentity": "qualified",
        "userSubjectMatches": true
      },
      "expectedDecision": "HOLD_PRE_GATE"
    },
    {
      "id": "H17",
      "name": "execution with no independent postgate",
