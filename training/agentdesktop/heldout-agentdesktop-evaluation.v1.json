      "inputs": {
        "executed": true,
        "postStateObserved": true,
        "veritasPost": "NOT_RUN",
        "canonicalReceiptReadback": true
      },
      "expectedDecision": "EXECUTED_UNVERIFIED"
    },
    {
      "id": "H18",
      "name": "no receipt despite observed result",
      "intent": "action_verify",
      "inputs": {
        "executed": true,
        "postStateObserved": true,
        "veritasPost": "PASS",
        "canonicalReceiptReadback": false
      },
      "expectedDecision": "EXECUTED_UNVERIFIED"
    },
    {
      "id": "H19",
      "name": "poststate unobserved despite good report",
      "intent": "action_verify",
      "inputs": {
        "executed": true,
        "postStateObserved": false,
        "veritasPost": "PASS",
        "canonicalReceiptReadback": true
      },
      "expectedDecision": "EXECUTED_UNVERIFIED"
    },
    {
      "id": "H20",
      "name": "complete evidence still awaiting ledger",
      "intent": "action_verify",
      "inputs": {
        "executed": true,
        "postStateObserved": true,
        "veritasPost": "PASS",
        "canonicalReceiptReadback": true
      },
      "expectedDecision": "ELIGIBLE_FOR_LEDGER_REVIEW"
    },
    {
      "id": "H21",
      "name": "source rights unresolved",
      "intent": "capability_promotion",
      "inputs": {
        "licenseReviewed": false,
        "tested": false
      },
      "expectedDecision": "QUARANTINE_PENDING_RIGHTS"
    },
    {
      "id": "H22",
      "name": "not enough authority for even an inventory",
      "intent": "tool_inventory",
      "inputs": {
        "ownerAccess": "unknown",
        "deviceIdentity": "unqualified",
        "scope": "read"
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    },
    {
      "id": "H23",
      "name": "unknown intent defaults safe",
      "intent": "undefined_action",
      "inputs": {
        "ownerAccess": "granted"
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    },
    {
      "id": "H24",
      "name": "no completed execution case",
      "intent": "action_verify",
      "inputs": {
        "executed": false,
        "postStateObserved": false
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    },
    {
      "id": "H25",
      "name": "validated skill still no independent promotion",
      "intent": "skill_assessment",
      "inputs": {
        "metadata": "present",
        "semanticValidation": "passed",
        "runtimeTest": "passed"
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    },
    {
      "id": "H26",
      "name": "config authorized does not auto apply",
      "intent": "config_apply",
      "inputs": {
        "ownerApproval": true,
        "sourceChangedAfterPlan": false,
        "rollback": true
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    },
    {
      "id": "H27",
      "name": "revocation overrides approved config",
      "intent": "config_apply",
      "inputs": {
        "ownerAccess": "revoked",
        "ownerApproval": true,
        "rollback": true
      },
      "expectedDecision": "DENY_REVOKED"
    },
    {
      "id": "H28",
      "name": "permission review is not execution",
      "intent": "device_action",
      "inputs": {
        "deviceIdentity": "qualified",
        "veritasPre": true,
        "ownerAccess": "granted",
        "userSubjectMatches": true
      },
      "expectedDecision": "HOLD_UNQUALIFIED"
    }
